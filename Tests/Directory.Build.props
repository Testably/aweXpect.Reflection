<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props" Condition="Exists('$(MSBuildThisFileDirectory)/../Directory.Build.props')"/>

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<SignAssembly>False</SignAssembly>
		<NoWarn>701;1702;CA1845</NoWarn>
		<WarningsAsErrors>$(WarningsAsErrors);CS8620</WarningsAsErrors>
	</PropertyGroup>

	<!--
	    The tests run on TUnit as executables of the Microsoft.Testing.Platform. TUnit discovers them through
	    reflection instead of its source generator, so that test arguments can refer to private nested types.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
		<!-- The implicit usings of TUnit import `HookType` statically, whose `Assembly` clashes with `System.Reflection`. -->
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit.Engine"/>
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport"/>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
		<PackageReference Include="Nullable">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="aweXpect"/>
	</ItemGroup>

</Project>
